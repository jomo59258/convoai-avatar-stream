# --- Agora core (required) ---
AGORA_APP_ID=
NEXT_PUBLIC_AGORA_APP_ID=           # same App ID, exposed to the browser
AGORA_APP_CERTIFICATE=              # server-only; mints short-lived RTC, RTM, and ConvoAI tokens

# Optional: only needed for instant server-to-client state broadcasts through
# the RTM REST API. ConvoAI calls use scoped token auth and do not need these.
AGORA_USERNAME=                     # RESTful API Customer ID / key
AGORA_PASSWORD=                     # RESTful API Customer Secret

# --- Optional Anam avatar ---
ANAM_API_KEY=
ANAM_AVATAR_ID=

# --- Lemonslice avatar (the default setup-screen provider) ---
# AVATAR_ID accepts an agent id (agent_…) OR a public https image URL; hosts can
# also override per stream via the setup form. A Lemonslice /pipeline dashboard
# URL is not an image URL; copy the public source image URL or agent id instead.
# Uses Agora's generic avatar interface (vendor: generic + Lemonslice's liveai endpoint).
LEMONSLICE_API_KEY=
LEMONSLICE_AVATAR_ID=

# --- Optional tuning (defaults shown) ---
AGORA_ASR_PRESET=deepgram_nova_3
AGORA_LLM_PRESET=openai_gpt_4o_mini
AGORA_TTS_PRESET=minimax_speech_2_6_turbo
MINIMAX_VOICE_ID=English_captivating_female1
MINIMAX_VOICE_ID_MALE=    # used when the setup form's voice toggle is Male
TTS_SPEED=1.0
AVATAR_AGORA_UID=102

# Other vendors (Microsoft TTS, OpenAI TTS preset, HeyGen avatars) exist in
# lib/agoraService.js but aren't exposed by the setup UI — see the README.

# --- Upstash Redis (channel state; from the Vercel Marketplace integration) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Host access (guests stay public) ---
# Local dev defaults to bypass; use AUTH_MODE=pin to exercise the PIN screen.
# Production always requires HOST_PIN regardless of AUTH_MODE.
AUTH_MODE=bypass
HOST_PIN=                            # 4–12 digits; store only in environment variables
SESSION_JWT_SECRET=                 # openssl rand -hex 48
